{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 1,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "ninja-base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "default",
            "inherits": "ninja-base",
            "displayName": "Default (Release)",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "GSST_BUILD_TESTS": "ON",
                "GSST_BUILD_BENCHMARKS": "ON",
                "GSST_BUILD_EXAMPLES": "ON",
                "GSST_ENABLE_CLANG_TIDY": "ON",
                "GSST_ENABLE_CPPCHECK": "ON"
            }
        },
        {
            "name": "debug",
            "inherits": "ninja-base",
            "displayName": "Debug",
            "binaryDir": "${sourceDir}/build-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "GSST_BUILD_TESTS": "ON",
                "GSST_BUILD_BENCHMARKS": "OFF",
                "GSST_BUILD_EXAMPLES": "ON"
            }
        },
        {
            "name": "release",
            "inherits": "ninja-base",
            "displayName": "Release (no extras)",
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "GSST_BUILD_TESTS": "OFF",
                "GSST_BUILD_BENCHMARKS": "OFF",
                "GSST_BUILD_EXAMPLES": "OFF"
            }
        },
        {
            "name": "ci",
            "inherits": "ninja-base",
            "displayName": "CI",
            "binaryDir": "${sourceDir}/build-ci",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CUDA_ARCHITECTURES": "80",
                "GSST_BUILD_TESTS": "ON",
                "GSST_BUILD_BENCHMARKS": "ON",
                "GSST_BUILD_EXAMPLES": "ON",
                "GSST_ENABLE_CLANG_TIDY": "ON",
                "GSST_ENABLE_CPPCHECK": "ON"
            }
        },
        {
            "name": "ci-debug",
            "inherits": "ninja-base",
            "displayName": "CI Debug",
            "binaryDir": "${sourceDir}/build-ci-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CUDA_ARCHITECTURES": "80",
                "GSST_BUILD_TESTS": "ON",
                "GSST_BUILD_BENCHMARKS": "OFF",
                "GSST_BUILD_EXAMPLES": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "ci",
            "configurePreset": "ci"
        },
        {
            "name": "ci-debug",
            "configurePreset": "ci-debug"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "ci",
            "configurePreset": "ci",
            "output": {
                "outputOnFailure": true,
                "verbosity": "verbose"
            },
            "execution": {
                "timeout": 300,
                "jobs": 4
            }
        },
        {
            "name": "ci-debug",
            "configurePreset": "ci-debug",
            "output": {
                "outputOnFailure": true,
                "verbosity": "verbose"
            },
            "execution": {
                "timeout": 600,
                "jobs": 4
            }
        }
    ]
}